{
 "tool": "grep",
 "version_cmd": "grep --version",
 "flag_help": "grep --help",
 "entries": [
  {
   "id": "grep-i",
   "cmd": "grep -i",
   "what": "match ignoring upper/lower case",
   "args": [
    {
     "flag": "-i, --ignore-case",
     "meaning": "'banana' also finds 'Banana' and 'BANANA'"
    }
   ],
   "example": "grep -i banana f.txt",
   "setup": "printf 'apple\\nBanana\\ncherry\\napple pie\\napp\\n' > f.txt",
   "run": "grep -i banana f.txt",
   "level": "tested",
   "expect": "Banana"
  },
  {
   "id": "grep-n",
   "cmd": "grep -n",
   "what": "show the line number before each match",
   "args": [
    {
     "flag": "-n, --line-number",
     "meaning": "prints 'number:line' so you can jump to it in an editor"
    }
   ],
   "example": "grep -n apple f.txt",
   "setup": "printf 'apple\\nBanana\\ncherry\\napple pie\\napp\\n' > f.txt",
   "run": "grep -n apple f.txt",
   "level": "tested",
   "expect": "1:apple\n4:apple pie"
  },
  {
   "id": "grep-v",
   "cmd": "grep -v",
   "what": "show only lines that do NOT match",
   "args": [
    {
     "flag": "-v, --invert-match",
     "meaning": "flips the result: keeps the lines without the pattern"
    }
   ],
   "example": "grep -v apple f.txt",
   "setup": "printf 'apple\\nBanana\\ncherry\\napple pie\\napp\\n' > f.txt",
   "run": "grep -v apple f.txt",
   "level": "tested",
   "expect": "Banana\ncherry\napp"
  },
  {
   "id": "grep-c",
   "cmd": "grep -c",
   "what": "count matching lines instead of printing them",
   "args": [
    {
     "flag": "-c, --count",
     "meaning": "prints one number: how many lines match (lines, not words)"
    }
   ],
   "example": "grep -c apple f.txt",
   "setup": "printf 'apple\\nBanana\\ncherry\\napple pie\\napp\\n' > f.txt",
   "run": "grep -c apple f.txt",
   "level": "tested",
   "expect": "2"
  },
  {
   "id": "grep-w",
   "cmd": "grep -w",
   "what": "match whole words only",
   "args": [
    {
     "flag": "-w, --word-regexp",
     "meaning": "'app' matches the word app but not 'apple'"
    }
   ],
   "example": "grep -w app f.txt",
   "setup": "printf 'apple\\nBanana\\ncherry\\napple pie\\napp\\n' > f.txt",
   "run": "grep -w app f.txt",
   "level": "tested",
   "expect": "app"
  },
  {
   "id": "grep-E",
   "cmd": "grep -E",
   "what": "use extended regex: | for 'or', + ? () without backslashes",
   "args": [
    {
     "flag": "-E, --extended-regexp",
     "meaning": "lets you write 'a|b' instead of 'a\\|b'"
    }
   ],
   "example": "grep -E 'cherry|Banana' f.txt",
   "setup": "printf 'apple\\nBanana\\ncherry\\napple pie\\napp\\n' > f.txt",
   "run": "grep -E 'cherry|Banana' f.txt",
   "gotcha": "always quote the pattern, or the shell eats the |",
   "level": "tested",
   "expect": "Banana\ncherry"
  },
  {
   "id": "grep-o",
   "cmd": "grep -o",
   "what": "print only the matching part, one per line",
   "args": [
    {
     "flag": "-o, --only-matching",
     "meaning": "prints just the match, not the whole line"
    }
   ],
   "example": "grep -o pp f.txt",
   "setup": "printf 'apple\\nBanana\\ncherry\\napple pie\\napp\\n' > f.txt",
   "run": "grep -o pp f.txt",
   "level": "tested",
   "expect": "pp\npp\npp"
  },
  {
   "id": "grep-r",
   "cmd": "grep -r",
   "what": "search every file inside a folder, going into subfolders",
   "args": [
    {
     "flag": "-r, --recursive",
     "meaning": "give it a folder; it searches all files below it and prints 'file:line'"
    }
   ],
   "example": "grep -r cherry d",
   "setup": "printf 'apple\\ncherry\\n' > f.txt; mkdir d; cp f.txt d/a.txt; cp f.txt d/b.txt",
   "run": "grep -r cherry d | sort",
   "level": "tested",
   "expect": "d/a.txt:cherry\nd/b.txt:cherry"
  },
  {
   "id": "grep-l",
   "cmd": "grep -l",
   "what": "list only the names of files that contain a match",
   "args": [
    {
     "flag": "-l, --files-with-matches",
     "meaning": "prints file names, not lines; stops at the first match per file"
    }
   ],
   "example": "grep -l cherry d/*.txt",
   "setup": "printf 'apple\\ncherry\\n' > f.txt; mkdir d; cp f.txt d/a.txt; cp f.txt d/b.txt",
   "run": "grep -l cherry d/*.txt",
   "level": "tested",
   "expect": "d/a.txt\nd/b.txt"
  },
  {
   "id": "grep-A",
   "cmd": "grep -A",
   "what": "also show N lines after each match",
   "args": [
    {
     "flag": "-A NUM, --after-context=NUM",
     "meaning": "-A1 shows the match plus the 1 line below it (-B = before, -C = both)"
    }
   ],
   "example": "grep -A1 cherry f.txt",
   "setup": "printf 'apple\\nBanana\\ncherry\\napple pie\\napp\\n' > f.txt",
   "run": "grep -A1 cherry f.txt",
   "level": "tested",
   "expect": "cherry\napple pie"
  }
 ]
}